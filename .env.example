# Copy to .env and fill in. Never commit .env.

# Required for the three open-weight primary models.
GROQ_API_KEY=

# Groq OpenAI-compatible endpoint. Do not change unless Groq documents a new URL.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional. Used only for the $20-capped frontier spot-check.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# bfcl-eval writes results here when invoked. Not required for AmbiSense task extraction.
BFCL_PROJECT_ROOT=
